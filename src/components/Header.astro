---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="Main navigation">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="brand-mark" aria-hidden="true">C<span>&amp;</span>C</span>
			<span class="brand-name">{SITE_TITLE}<small>THE BEAUTY JOURNAL</small></span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog/">Lookbook</HeaderLink>
			<HeaderLink href="/blog/using-mdx/">Hair units</HeaderLink>
			<HeaderLink href="/blog/third-post/">Nail art</HeaderLink>
			<HeaderLink href="/about/">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		position: relative;
		z-index: 2;
		margin: 0;
		padding: 0 max(1.5rem, calc((100vw - 1180px) / 2));
		background: rgb(252 248 245 / 94%);
		border-bottom: 1px solid var(--line);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 78px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		color: var(--ink);
		text-decoration: none;
	}
	.brand-mark {
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		border: 1px solid var(--accent);
		border-radius: 50%;
		color: var(--accent);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 0.78rem;
		letter-spacing: -0.08em;
	}
	.brand-mark span {
		margin: 0 -0.08em;
		color: var(--ink);
		font-size: 0.63rem;
	}
	.brand-name {
		display: grid;
		gap: 0.08rem;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 1.15rem;
		line-height: 1;
	}
	.brand-name small {
		color: rgb(var(--gray));
		font-family: var(--font-atkinson), sans-serif;
		font-size: 0.48rem;
		font-weight: 700;
		letter-spacing: 0.15em;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: clamp(0.35rem, 2vw, 1.4rem);
	}
	.internal-links :global(a) {
		padding: 0.85rem 0.15rem;
		color: var(--ink);
		border-bottom: 1px solid transparent;
		font-size: 0.7rem;
		font-weight: 700;
		text-decoration: none;
	}
	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}
	@media (max-width: 640px) {
		header {
			padding: 0 1rem;
		}
		nav {
			align-items: flex-start;
			flex-direction: column;
			gap: 0;
			padding: 0.8rem 0 0;
		}
		.brand {
			padding-bottom: 0.5rem;
		}
		.internal-links {
			width: 100%;
			justify-content: space-between;
			gap: 0.4rem;
			overflow-x: auto;
		}
		.internal-links :global(a) {
			padding: 0.6rem 0.05rem 0.75rem;
			font-size: 0.65rem;
			white-space: nowrap;
		}
	}
</style>
