---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, category, pubDate, updatedDate, heroImage, heroImageAlt } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${title} | ${SITE_TITLE}`}
			description={description}
			image={heroImage}
			imageAlt={heroImageAlt ?? description}
		/>
	</head>
	<body>
		<Header />
		<main class="article-page">
			<article>
				<header class="article-heading">
					<a class="back-link" href="/blog/"><span aria-hidden="true">←</span> Back to the lookbook</a>
					<p class="eyebrow">{category}</p>
					<h1>{title}</h1>
					<p class="article-description">{description}</p>
					<div class="article-meta">
						<FormattedDate date={pubDate} />
						{updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
					</div>
				</header>
				{heroImage && (
					<div class="article-image">
						<Image
							src={heroImage}
							width={1440}
							height={810}
							alt={heroImageAlt ?? title}
							loading="eager"
						/>
					</div>
				)}
				<div class="article-content">
					<slot />
				</div>
				<aside class="article-end">
					<p class="eyebrow">Keep exploring</p>
					<a href="/blog/">More ideas from the journal <span aria-hidden="true">↗</span></a>
				</aside>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-page {
		width: min(100% - 3rem, 1060px);
		max-width: none;
		padding: 3.5rem 0 5rem;
	}
	.article-heading {
		max-width: 760px;
		margin: 0 auto 2rem;
	}
	.back-link {
		display: inline-block;
		margin-bottom: 2rem;
		color: rgb(var(--gray));
		font-size: 0.69rem;
		font-weight: 700;
		text-decoration: none;
	}
	.back-link:hover {
		color: var(--accent);
	}
	.back-link span {
		margin-right: 0.35rem;
		color: var(--accent);
	}
	.eyebrow {
		margin: 0 0 0.8rem;
		color: var(--accent);
		font-size: 0.67rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	h1 {
		margin: 0;
		color: var(--ink);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(2.7rem, 6vw, 4.9rem);
		font-weight: 400;
		letter-spacing: -0.045em;
		line-height: 1.02;
	}
	.article-description {
		max-width: 640px;
		margin: 1rem 0 1.25rem;
		color: rgb(var(--gray));
		font-size: 0.95rem;
		line-height: 1.65;
	}
	.article-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		color: rgb(var(--gray));
		font-size: 0.67rem;
	}
	.article-image {
		max-height: 600px;
		margin: 0 auto 2.6rem;
		overflow: hidden;
		background: #e6d9d0;
	}
	.article-image img {
		display: block;
		width: 100%;
		max-height: 600px;
		border-radius: 0;
		object-fit: cover;
	}
	.article-content {
		width: min(100%, 720px);
		margin: 0 auto;
		padding: 0 0.5rem;
		color: rgb(var(--gray-dark));
		font-size: 0.91rem;
		line-height: 1.85;
	}
	.article-content :global(h2) {
		margin: 2.3rem 0 0.6rem;
		color: var(--ink);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 1.7rem;
		font-weight: 400;
		letter-spacing: -0.02em;
	}
	.article-content :global(h3) {
		margin: 1.8rem 0 0.5rem;
		color: var(--ink);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 1.3rem;
		font-weight: 400;
	}
	.article-content :global(p) {
		margin: 0 0 1.1rem;
	}
	.article-content :global(a) {
		color: var(--accent);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}
	.article-content :global(ul) {
		padding-left: 1.3rem;
	}
	.article-content :global(li) {
		padding-left: 0.2rem;
		margin-bottom: 0.45rem;
	}
	.article-content :global(blockquote) {
		margin: 1.5rem 0;
		padding: 0.2rem 0 0.2rem 1rem;
		border-left: 2px solid var(--accent);
		color: rgb(var(--gray));
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 1.15rem;
	}
	.article-end {
		width: min(100%, 720px);
		margin: 3rem auto 0;
		padding: 1.4rem 0 0;
		border-top: 1px solid var(--line);
	}
	.article-end .eyebrow {
		margin-bottom: 0.45rem;
	}
	.article-end a {
		color: var(--ink);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 1.4rem;
		text-decoration: none;
	}
	.article-end a span {
		color: var(--accent);
	}
	@media (max-width: 600px) {
		.article-page {
			width: min(100% - 2rem, 560px);
			padding: 2.4rem 0 3.5rem;
		}
		.article-heading {
			margin-bottom: 1.5rem;
		}
		.back-link {
			margin-bottom: 1.5rem;
		}
		.article-image {
			margin-bottom: 1.8rem;
		}
		.article-content {
			padding: 0;
			font-size: 0.87rem;
		}
	}
</style>
