---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Lookbook | ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
			image={posts[0]?.data.heroImage}
			imageAlt={posts[0]?.data.heroImageAlt}
		/>
	</head>
	<body>
		<Header />
		<main class="blog-index">
			<header class="page-heading">
				<p class="eyebrow">The journal</p>
				<h1>Ideas to <em>save.</em></h1>
				<p>Style notes, care pointers, and inspiration for your next conversation with a beauty artist.</p>
			</header>
			<section aria-label="All style stories">
				<div class="post-grid">
					{posts.map((post) => (
						<article class="post-card">
							<a class="post-image" href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<Image
										src={post.data.heroImage}
										width={780}
										height={585}
										alt={post.data.heroImageAlt ?? post.data.title}
									/>
								)}
							</a>
							<div class="post-meta">
								<span>{post.data.category}</span>
								<FormattedDate date={post.data.pubDate} />
							</div>
							<h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
							<p>{post.data.description}</p>
							<a class="read-link" href={`/blog/${post.id}/`}>Read the story <span aria-hidden="true">→</span></a>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.blog-index {
		width: min(1180px, calc(100% - 3rem));
		max-width: none;
		padding: 4.5rem 0 6rem;
	}
	.page-heading {
		max-width: 720px;
		margin-bottom: 3rem;
	}
	.eyebrow {
		margin: 0 0 0.9rem;
		color: var(--accent);
		font-size: 0.67rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	h1,
	h2 {
		font-family: Georgia, 'Times New Roman', serif;
		font-weight: 400;
		letter-spacing: -0.04em;
	}
	h1 {
		margin: 0;
		color: var(--ink);
		font-size: clamp(3.2rem, 7vw, 5.5rem);
		line-height: 1;
	}
	h1 em {
		color: var(--accent);
		font-weight: 400;
	}
	.page-heading > p:last-child {
		max-width: 560px;
		margin: 1rem 0 0;
		color: rgb(var(--gray));
		font-size: 0.9rem;
		line-height: 1.6;
	}
	.post-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2.6rem 1.5rem;
	}
	.post-image {
		display: block;
		aspect-ratio: 4 / 3;
		margin-bottom: 0.9rem;
		overflow: hidden;
		background: #e6d9d0;
	}
	.post-image img {
		width: 100%;
		height: 100%;
		border-radius: 0;
		object-fit: cover;
		transition: transform 350ms ease;
	}
	.post-image:hover img {
		transform: scale(1.035);
	}
	.post-meta {
		display: flex;
		justify-content: space-between;
		gap: 0.6rem;
		color: rgb(var(--gray));
		font-size: 0.63rem;
	}
	.post-meta span {
		color: var(--accent);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.post-card h2 {
		margin: 0.7rem 0 0.45rem;
		font-size: 1.65rem;
		line-height: 1.1;
	}
	.post-card h2 a {
		color: var(--ink);
		text-decoration: none;
	}
	.post-card h2 a:hover {
		color: var(--accent);
	}
	.post-card > p {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.78rem;
		line-height: 1.55;
	}
	.read-link {
		display: inline-block;
		margin-top: 0.8rem;
		color: var(--ink);
		font-size: 0.71rem;
		font-weight: 700;
		text-decoration: none;
	}
	.read-link span {
		color: var(--accent);
	}
	@media (max-width: 850px) {
		.post-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 600px) {
		.blog-index {
			width: min(100% - 2rem, 560px);
			padding: 3rem 0 4rem;
		}
		.post-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.post-card h2 {
			font-size: 1.6rem;
		}
	}
</style>
