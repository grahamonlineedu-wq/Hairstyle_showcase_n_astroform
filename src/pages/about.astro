---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="about-page">
			<section class="about-hero">
				<p class="eyebrow">About the showcase</p>
				<h1>Beauty is in the <em>details.</em></h1>
				<p class="lede">
					{SITE_TITLE} is a style journal for expressive hair, considered grooming, and the
					artists who bring a look together.
				</p>
			</section>

			<section class="about-body">
				<div class="about-copy">
					<p class="eyebrow">Our point of view</p>
					<h2>Good inspiration should be <em>useful, too.</em></h2>
					<p>
						This showcase brings hairstyle ideas, nail-art details, and hair-unit guidance into
						one place. It is made for anyone saving a look for later—and for the professional
						artists whose skill turns inspiration into a result that fits the person wearing it.
					</p>
					<p>
						We believe a great consultation matters as much as the final photo. Texture, comfort,
						time, maintenance, and personal style all belong in the conversation.
					</p>
					<a class="button" href="/blog/">Explore the lookbook <span>↗</span></a>
				</div>
				<div class="service-list" aria-label="Featured beauty disciplines">
					<div><span>01</span><strong>Hair artistry</strong><small>Protective styles · natural texture</small></div>
					<div><span>02</span><strong>Men’s grooming</strong><small>Barbering · silver and natural styles</small></div>
					<div><span>03</span><strong>Nail design</strong><small>Gel · extensions · detailed finishes</small></div>
					<div><span>04</span><strong>Hair units</strong><small>Wigs · weaves · extensions</small></div>
				</div>
			</section>

			<section class="artist-callout">
				<p class="eyebrow">A note for beauty professionals</p>
				<h2>Let the craft lead.</h2>
				<p>
					Use the articles as consultation starters, share ideas with clients, and adapt each
					inspiration to the person in your chair. Every technique, texture, and routine is
					different.
				</p>
				<a href="/blog/markdown-style-guide/">Read the consultation checklist <span>→</span></a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-page {
		width: min(1040px, calc(100% - 3rem));
		max-width: none;
		padding: 5rem 0 6rem;
	}
	.eyebrow {
		margin: 0 0 1rem;
		color: var(--accent);
		font-size: 0.67rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	h1,
	h2 {
		font-family: Georgia, 'Times New Roman', serif;
		font-weight: 400;
		letter-spacing: -0.045em;
	}
	h1 em,
	h2 em {
		color: var(--accent);
		font-weight: 400;
	}
	.about-hero {
		max-width: 720px;
		padding-bottom: 3rem;
		border-bottom: 1px solid var(--line);
	}
	h1 {
		margin: 0;
		font-size: clamp(3.3rem, 8vw, 6rem);
		line-height: 1;
	}
	.lede {
		max-width: 540px;
		margin: 1.5rem 0 0;
		color: rgb(var(--gray));
		font-size: 1.05rem;
		line-height: 1.7;
	}
	.about-body {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: clamp(2rem, 7vw, 6rem);
		padding: 3.5rem 0;
	}
	.about-copy h2 {
		max-width: 500px;
		margin: 0 0 1.2rem;
		font-size: clamp(2.2rem, 4vw, 3.6rem);
		line-height: 1.08;
	}
	.about-copy > p:not(.eyebrow) {
		color: rgb(var(--gray));
		font-size: 0.85rem;
		line-height: 1.75;
	}
	.button {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		margin-top: 0.5rem;
		padding: 0.8rem 1.1rem;
		background: var(--ink);
		color: white;
		font-size: 0.74rem;
		font-weight: 700;
		text-decoration: none;
	}
	.button:hover {
		background: var(--accent);
		color: white;
	}
	.service-list {
		align-self: center;
		border-top: 1px solid var(--line);
	}
	.service-list > div {
		display: grid;
		grid-template-columns: 2rem 1fr;
		gap: 0.25rem 0.75rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--line);
	}
	.service-list span {
		grid-row: span 2;
		color: var(--accent);
		font-size: 0.63rem;
	}
	.service-list strong {
		color: var(--ink);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 1.25rem;
		font-weight: 400;
	}
	.service-list small {
		color: rgb(var(--gray));
		font-size: 0.68rem;
	}
	.artist-callout {
		padding: 2rem;
		background: #f2e9e4;
	}
	.artist-callout h2 {
		margin: 0;
		color: var(--ink);
		font-size: 2.4rem;
	}
	.artist-callout > p:not(.eyebrow) {
		max-width: 640px;
		color: rgb(var(--gray));
		font-size: 0.8rem;
		line-height: 1.65;
	}
	.artist-callout a {
		color: var(--accent);
		font-size: 0.76rem;
		font-weight: 700;
		text-decoration: none;
	}
	@media (max-width: 700px) {
		.about-page {
			width: min(100% - 2rem, 560px);
			padding: 3.5rem 0;
		}
		.about-body {
			grid-template-columns: 1fr;
			gap: 2.5rem;
			padding: 2.5rem 0;
		}
		.artist-callout {
			padding: 1.5rem;
		}
	}
</style>
